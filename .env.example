# APP_URL: The URL where this applet is hosted.
APP_URL="https://kalametgame.ir"

# PORT: Port for Express server (defaults to 3000).
PORT=3000

# SESSION_SECRET: Long random secret for signing admin HTTP-only cookies.
SESSION_SECRET=""

# Optional Admin credentials (if omitted, first-time setup is available on /admin)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Supabase Integration (optional — leave empty to use local persistent storage)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# GEMINI_API_KEY: Optional server-side Gemini API key.
GEMINI_API_KEY=""
